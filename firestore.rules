rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    // A "personal" task/list uses listId == owner's uid (or listId is absent).
    // A "shared" task/list has a real /lists/{listId} doc with a memberUids array.
    function isMemberOfList(listId) {
      return listId == request.auth.uid ||
        (exists(/databases/$(database)/documents/lists/$(listId)) &&
         request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.memberUids);
    }

    function isOwnerOfList(listId) {
      return exists(/databases/$(database)/documents/lists/$(listId)) &&
        get(/databases/$(database)/documents/lists/$(listId)).data.ownerId == request.auth.uid;
    }

    // ---------- users ----------
    // One doc per account (id == uid), used so members can be looked up by email
    // when inviting them to a shared list. Any signed-in user can read (needed for
    // the email-lookup query) but can only ever write their own doc.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- lists ----------
    match /lists/{listId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;

      // Only the owner can rename the list or change membership (invite/remove).
      // memberUids/memberEmails must stay in lockstep and the owner can never be removed.
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerId in request.resource.data.memberUids;

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ---------- tasks ----------
    match /tasks/{taskId} {
      allow read: if signedIn() && isMemberOfList(resource.data.listId == null ? resource.data.userId : resource.data.listId);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && isMemberOfList(request.resource.data.listId == null ? request.auth.uid : request.resource.data.listId)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.priority in ['low', 'medium', 'high']
        && request.resource.data.status in ['pending', 'done']
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 20
        && request.resource.data.subtasks is list;

      // Anyone who's a member of the task's list can edit/complete/reorder it
      // (that's the point of a shared list) — but userId/listId can't be hijacked
      // by rewriting the doc to move it into a list you don't belong to.
      allow update: if signedIn()
        && isMemberOfList(resource.data.listId == null ? resource.data.userId : resource.data.listId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.listId == resource.data.listId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.priority in ['low', 'medium', 'high']
        && request.resource.data.status in ['pending', 'done'];

      allow delete: if signedIn() && isMemberOfList(resource.data.listId == null ? resource.data.userId : resource.data.listId);
    }

    // ---------- presence (who's viewing / typing on a shared list) ----------
    match /presence/{presenceId} {
      allow read: if signedIn() && isMemberOfList(resource.data.listId);

      // Doc id is `${listId}_${uid}` and a user may only ever write their own
      // presence doc, and only for a list they actually belong to.
      allow write: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && presenceId == request.resource.data.listId + '_' + request.auth.uid
        && isMemberOfList(request.resource.data.listId);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
